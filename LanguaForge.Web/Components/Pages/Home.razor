@page "/home"
@layout AppLayout
@inject LanguaForge.Web.Services.ApiClient ApiClient
@using System.Net.Http.Json
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject LanguaForge.Web.Services.TokenService TokenService
@inject IJSRuntime JS

<div class="home-container">
    <section class="welcome-section">
        <h1>Bonjour, @FirstName</h1>
        <p>Ready to sharpen your language skills today? Complete your daily challenge.</p>
    </section>

    <section class="prompt-card">
        <h2>@PromptText</h2>
        <span class="difficulty">@PromptLevel</span>
    </section>

    <section class="response-card">
        <label>Your response</label>

        <textarea placeholder="Écrivez votre réponse ici..."></textarea>

        <button>Submit Response</button>
    </section>
</div>

@code {
    private string PromptText { get; set; } = "Loading...";
    private string PromptLevel { get; set; } = "";

    private string FirstName { get; set; } = "User";


    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
            return;

        // Restore token from localStorage if lost due to a page reload
        if (string.IsNullOrEmpty(TokenService.GetToken()))
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "jwt_token");
            if (!string.IsNullOrEmpty(stored))
                TokenService.SetToken(stored);
        }

        // Get current logged-in user
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var currentUser = authState.User;

        if (currentUser.Identity?.IsAuthenticated == true)
        {
            FirstName = currentUser.FindFirst("FirstName")?.Value 
                        ?? currentUser.Identity.Name 
                        ?? "User";
        }

        // Get daily prompt AND current user
        var client = ApiClient.Create();

        var prompt = await client.GetFromJsonAsync<PromptResponse>("api/prompts/today");
        
        if (prompt is not null)
        {
            PromptText = prompt.Text;

            PromptLevel = prompt.Level switch
            {
                0 => "Beginner",
                1 => "Intermediate",
                2 => "Advanced",
                _ => "Unknown"
            };
        }
    }

    private record PromptResponse(int Id, string Text, int Level);
}