@page "/register"
@layout AuthLayout
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@using LanguaForge.Web.Models
@using MudBlazor

<div class="auth-card">
    <div class="auth-header">
        <h2>Create account</h2>
        <p>Start your language journey</p>
    </div>

    <form @onsubmit="HandleRegister">
        <div class="form-group">
            <label>First name</label>
            <input @bind="registerModel.FirstName"
                   type="text"
                   placeholder="Enter your first name" />
        </div>

        <div class="form-group">
            <label>Last name</label>
            <input @bind="registerModel.LastName"
                   type="text"
                   placeholder="Enter your last name" />
        </div>

        <div class="form-group">
            <label>Email</label>
            <input @bind="registerModel.Email"
                   type="email"
                   placeholder="Enter your email" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <input @bind="registerModel.Password"
                   type="password"
                   placeholder="Create a password" />
        </div>

        <div class="form-group">
            <label>Confirm password</label>
            <input type="password"
                   placeholder="Confirm your password" />
        </div>

        <button class="auth-button" type="submit">
            Register
        </button>
    </form>

    <div class="auth-footer">
        Already have an account?
        <a href="/">Sign in</a>
    </div>
</div>


@code {

    private RegisterModel registerModel = new();


    private async Task HandleRegister()
    {
        var client = HttpClientFactory.CreateClient("API");

        var response = await client.PostAsJsonAsync(
            "api/auth/register",
            registerModel
        );


        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            Snackbar.Add("Registration failed. Please check your details and try again.", Severity.Error);
        }
    }

}