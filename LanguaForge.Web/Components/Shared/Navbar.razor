@inject LanguaForge.Web.Services.TokenService TokenService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@rendermode InteractiveServer

<nav class="navbar">
    <a class="navbar-logo" href="/home">LanguaForge</a>

    <div class="navbar-right">
        <ul class="navbar-links">
            <li><NavLink href="/home" Match="NavLinkMatch.All">Home</NavLink></li>
            <li><NavLink href="/journal">Journal</NavLink></li>
        </ul>

        <button class="navbar-logout" @onclick="HandleLogout">
            Logout
        </button>
    </div>
</nav>

@code {
    private async Task HandleLogout()
    {
        // Clear token stored in memory
        TokenService.ClearToken();

        // Remove token stored in the browser
        await JS.InvokeVoidAsync(
            "localStorage.removeItem",
            "jwt_token"
        );

        Navigation.NavigateTo("/", forceLoad: true);
    }
}