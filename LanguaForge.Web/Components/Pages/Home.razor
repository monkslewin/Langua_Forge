@page "/home"
@layout AppLayout

<div class="home-container">
    <section class="welcome-section">
        <h1>Bonjour, Finn 👋</h1>
        <p>Ready to sharpen your language skills today? Complete your daily challenge.</p>
    </section>

    <section class="prompt-card">
        <div class="prompt-header">
            <span class="prompt-label">Daily Prompt</span>
            <span class="difficulty">Intermediate</span>
        </div>

        <h2>Describe your day in French</h2>
        <p>Write 3-5 sentences about what you did today. Try to use the past tense.</p>
    </section>

    <section class="response-card">
        <label>Your response</label>

        <textarea placeholder="Écrivez votre réponse ici..."></textarea>

        <button>Submit Response</button>
    </section>
</div>